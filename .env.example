# Fantasy Manager Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost/backend_dev

# Server Configuration
PORT=4000
SECRET_KEY_BASE=your_secret_key_base_here

# External API Keys
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here (optional, for LangChain fallback)
NFL_API_KEY=your_nfl_api_key_here (optional)

# External API Configuration
SLEEPER_BASE_URL=https://api.sleeper.app/v1
NFL_DATA_BASE_URL=https://api.nfl.com/v1

# Cache Configuration (optional overrides)
CACHE_TTL_HOURS=1
SLEEPER_CACHE_TTL_HOURS=1
NFL_CACHE_TTL_HOURS=2

# AI Configuration
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=60

# Development Settings
MIX_ENV=dev
PHX_SERVER=true